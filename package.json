  "build": {
    "appId": "com.techczech.talkweaver",
    "productName": "TalkWeaver",
    "asar": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "worker",
        "to": "worker"
      },
      {
        "from": "compiler",
        "to": "compiler"
      },
      {
        "from": "resources/agent-rewrite",
        "to": "agent-rewrite"
      },
      {
        "from": "resources/agent-import",
        "to": "agent-import"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "techczech",
      "repo": "talkweaver-app"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": "arm64"
        },
        {
          "target": "zip",
          "arch": "arm64"
        }
      ],
      "category": "public.app-category.productivity",
      "identity": "DOMINIK LUKES (M7H45AGG8A)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true,
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "native/ocr",
          "to": "ocr"
        },
        {
          "from": "native/media",
          "to": "media"
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "TalkWeaver records your microphone while you present, so you can review and transcribe what you said on each slide. Recording is opt-in — it only starts when you press ⇧R in the presenter."
      },
      "artifactName": "TalkWeaver-mac-arm64.${ext}"
    },
    "dmg": {
      "title": "TalkWeaver ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": "x64"
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "TalkWeaver-windows-x64-setup.${ext}"
    }
  },
