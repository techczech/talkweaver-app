{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "talkweaver-live-sessions",
  "main": "index.ts",
  "compatibility_date": "2026-05-14",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "durable_objects": {
    "bindings": [
      { "name": "LIVE_SESSIONS", "class_name": "LiveSession" },
      { "name": "SESSION_REGISTRY", "class_name": "SessionRegistry" },
      { "name": "SHARED_TALKS", "class_name": "SharedTalk" },
      { "name": "RUN_SHARES", "class_name": "RunShare" },
      { "name": "RUN_PREWORK", "class_name": "RunPrework" }
    ]
  },
  // BARRED: never add a migration that deletes or renames SessionRegistry (`deleted_classes`,
  // `renamed_classes`, `transferred_classes`), and never clear that object's storage. It keeps the
  // signing key of every live service that has no SESSION_SIGNING_SECRET (worker/signing-key.ts);
  // losing it ends every presenter and owner token of that service. See worker/README.md,
  // "Secrets and the signing key".
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LiveSession", "SessionRegistry"] },
    { "tag": "v2", "new_sqlite_classes": ["SharedTalk"] },
    { "tag": "v3", "new_sqlite_classes": ["RunShare"] },
    { "tag": "v4", "new_sqlite_classes": ["RunPrework"] }
  ],
  "observability": { "enabled": true }
}
